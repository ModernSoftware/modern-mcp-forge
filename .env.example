# Optional application-data directory. Forge stores forge.db inside it.
# Use an absolute path appropriate for your OS; see docs/app-data.md.
# MCP_FORGE_DATA_DIR=/absolute/path/to/forge-data

# Optional database-file override; takes precedence over MCP_FORGE_DATA_DIR.
# MCP_FORGE_DB_PATH=/absolute/path/to/forge.db

# Optional maintainer override. By default Forge uses MCPack from npm.
# FORGE_MCPACK_CLI=/absolute/path/to/mcpack/dist/cli.js

# Upstream token and separate checkout names are configured per source.
# Supply their values locally before starting Forge; never commit secrets.
# See docs/external-sources.md and docs/bridged-sources.md.
