# Optional application-data directory override.
# Forge stores forge.db inside this directory.
# MCP_FORGE_DATA_DIR=C:\\Users\\you\\AppData\\Local\\ModernMCPForge

# Optional database-file override. Takes precedence over MCP_FORGE_DATA_DIR.
# MCP_FORGE_DB_PATH=C:\\path\\to\\forge.db

# Optional override for a locally built MCPack CLI (otherwise use mcpack:setup).
# FORGE_MCPACK_CLI=C:/repos/mcpack/dist/cli.js
